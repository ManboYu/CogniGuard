# CogniGuard production deployment template.
# This is only a template. On the server, create the real file as .env.
# Do not commit .env. Keep QWEN_API_KEY only on the server.

DEMO_MODE=false
USE_CACHE=true
VOICE_DEMO_MODE=false

QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-your-dashscope-api-key

LLM_MODEL=qwen-max
VLM_MODEL=qwen-vl-max
ASR_MODEL=qwen3-asr-flash

TTS_MODEL=qwen-tts
TTS_MODEL_ASSISTANT=qwen-tts
TTS_VOICE_ASSISTANT=Cherry

TTS_MODEL_PATIENT_DEMO=cosyvoice-v3-flash
TTS_VOICE_PATIENT_DEMO=longlaoyi_v3

