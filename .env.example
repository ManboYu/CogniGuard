# CogniGuard demo configuration.
# Keep real keys only in .env. Do not commit .env.

# Unified Qwen configuration for DashScope Qwen-family APIs.
# If a dedicated LLM/VLM/ASR/TTS BASE_URL or API_KEY below is empty, CogniGuard uses
# QWEN_BASE_URL / QWEN_API_KEY for that Qwen-family model.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-your-dashscope-api-key

# Optional evaluator dataset generator. Used only by scripts/generate_deepseek_eval_cases.py.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional dedicated overrides. Leave empty to use QWEN_BASE_URL / QWEN_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-max

VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=qwen-vl-max

EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=

ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=qwen3-asr-flash

TTS_BASE_URL=
TTS_API_KEY=
# Compatibility default. Leave this as qwen-tts unless you need a global fallback.
TTS_MODEL=qwen-tts
# System interview questions use assistant model/voice first, then fall back to TTS_MODEL.
TTS_MODEL_ASSISTANT=qwen-tts
TTS_VOICE_ASSISTANT=Cherry
# Classroom simulated elder answers can use a separate CosyVoice model/voice.
TTS_MODEL_PATIENT_DEMO=cosyvoice-v3-flash
TTS_VOICE_PATIENT_DEMO=longlaoyi_v3
TTS_FORMAT=mp3

# TTS_VOICE_ASSISTANT is used for system interview questions.
# TTS_VOICE_PATIENT_DEMO is used for simulated elder answers on the classroom demo page.
# longlaoyi_v3 is an elder demo voice ID. It may require a CosyVoice-v3 model
# and account access. If the selected model/voice is unsupported, the page
# will fallback and the text demo flow still works.

DEMO_MODE=false
VOICE_DEMO_MODE=false
USE_CACHE=true

# Demo administrator password for staff-only pages.
STAFF_PASSWORD=8888
